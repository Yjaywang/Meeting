# Build stage
FROM node:18-bullseye-slim AS build

RUN corepack enable && corepack prepare pnpm@9.15.1 --activate

WORKDIR /usr/src/app

# Copy pnpm workspace config
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./

# Copy workspace package.json files for resolution
COPY server/package.json ./server/
COPY shared/package.json ./shared/
COPY my-app/package.json ./my-app/
COPY webSocket/package.json ./webSocket/

# Install dependencies for my-app (includes devDependencies for build)
RUN pnpm install --filter my-app... --frozen-lockfile

# Copy source
COPY my-app/ ./my-app/
COPY shared/ ./shared/

WORKDIR /usr/src/app/my-app

# Build for production
RUN pnpm run build


# Production stage
FROM node:18-bullseye-slim

RUN corepack enable && corepack prepare pnpm@9.15.1 --activate

WORKDIR /usr/src/app

RUN pnpm add -g serve

# Copy only the built static files from build stage
COPY --from=build /usr/src/app/my-app/dist ./dist

USER node
EXPOSE 3000

CMD ["serve", "-s", "dist"]
