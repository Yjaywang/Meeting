#download parent image
FROM node:26-bookworm-slim

#enable pnpm
RUN npm install -g corepack@latest && corepack enable

#set root dir
WORKDIR /usr/src/app

#copy pnpm workspace config
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./

#copy workspace package.json files for resolution
COPY server/package.json ./server/
COPY shared/package.json ./shared/
COPY my-app/package.json ./my-app/
COPY webSocket/package.json ./webSocket/

#install dependencies for my-app
RUN pnpm install --filter my-app... --frozen-lockfile

#copy my-app source
COPY my-app/ ./my-app/
COPY shared/ ./shared/

WORKDIR /usr/src/app/my-app

#open container port 3000
EXPOSE 3000

CMD ["pnpm", "start"]
